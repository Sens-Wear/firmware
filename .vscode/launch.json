{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CMSIS-DAP: flash and debug SensWear nRF54L15 (cpuapp), base (no shield)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "serverpath": "${workspaceFolder}/config/scripts/openocd-with-env.sh",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/app/base/${workspaceFolderBasename}/zephyr/zephyr.elf",
            "loadFiles": [],
            "gdbPath": "${workspaceFolder}/config/scripts/gdb-with-env.sh",
            "objdumpPath": "arm-zephyr-eabi-objdump",
            "armToolchainPrefix": "arm-zephyr-eabi",
            "windows": {
                "serverpath": "${workspaceFolder}\\config\\scripts\\openocd-with-env.cmd",
                "gdbPath": "${workspaceFolder}\\config\\scripts\\gdb-with-env.cmd",
                "objdumpPath": "arm-zephyr-eabi-objdump.exe"
            },
            "configFiles": [
                "${workspaceFolder}/config/openocd-cmsis-dap.cfg",
                "${workspaceFolder}/config/openocd-nrf54l15.cfg"
            ],
            "openOCDLaunchCommands": [
                "init",
                "reset init",
                "nrf54l-load {${workspaceFolder}/build/app/base/${workspaceFolderBasename}/zephyr/zephyr.hex}",
                "verify_image {${workspaceFolder}/build/app/base/${workspaceFolderBasename}/zephyr/zephyr.hex}",
                "reset halt"
            ],
            "preLaunchCommands": [
                "set mem inaccessible-by-default off",
                "mem 0x00000000 0x00180000 ro"
            ],
            "runToEntryPoint": "main",
            "rtos": "Zephyr",
            "showDevDebugOutput": "none"
        },
