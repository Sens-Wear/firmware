            "loadFiles": [],
            "gdbPath": "arm-zephyr-eabi-gdb",
            "objdumpPath": "arm-zephyr-eabi-objdump",
            "armToolchainPrefix": "arm-zephyr-eabi",
            "windows": {
                "serverpath": "${workspaceFolder}\\config\\scripts\\openocd-with-env.cmd",
