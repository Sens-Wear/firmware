                "gdbPath": "arm-zephyr-eabi-gdb.exe",
                "objdumpPath": "arm-zephyr-eabi-objdump.exe"
            },
            "configFiles": [
                "${workspaceFolder}/config/openocd-stlink-v2.cfg",
                "${workspaceFolder}/config/openocd-nrf54l15.cfg"
            ],
            "preLaunchCommands": [
                "set mem inaccessible-by-default off",
                "mem 0x00000000 0x00180000 ro"
            ],
            "preLaunchTask": "ST-Link/V2: flash nRF54L15",
            "runToEntryPoint": "main",
            "rtos": "Zephyr",
            "showDevDebugOutput": "none"
        },
        {
            "name": "J-Link/OpenOCD: flash and debug nRF54L15",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "serverpath": "${workspaceFolder}/config/scripts/openocd-with-env.sh",
