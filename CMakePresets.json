{
    "version": 5,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 23
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "environment": {
                "PATH": "$penv{NCS_TOOLCHAIN_ROOT}/bin${pathListSep}$penv{PATH}",
                "ZEPHYR_BASE": "$penv{ZEPHYR_BASE}",
                "ZEPHYR_SDK_INSTALL_DIR": "$penv{NCS_TOOLCHAIN_ROOT}/opt/zephyr-sdk",
                "ZEPHYR_TOOLCHAIN_VARIANT": "zephyr",
                "NINJA_STATUS": "[%f/%t] ",
                "CLICOLOR_FORCE": "1"
            },
            "cacheVariables": {
                "BOARD": "SensWear/nrf54l15/cpuapp",
                "BOARD_ROOT": "${sourceDir}"
            }
        },
        {
            "name": "senswear_nrf54l15_cpuapp",
            "displayName": "SensWear nRF54L15 (cpuapp)",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build"
        },
        {
            "name": "test_base",
            "hidden": true,
            "inherits": "base",
            "description": "Driver bring-up test: replaces the app main with the selected test main."
        },
        {
            "name": "test_bq25180",
            "displayName": "Test: BQ25180 charger",
            "inherits": "test_base",
            "binaryDir": "${sourceDir}/build/tests/bq25180",
            "cacheVariables": {
                "CONFIG_SENSEWEAR_TEST_BQ25180_DRIVER": "y",
                "CONFIG_SHELL": "n",
                "CONFIG_I2C_SHELL": "n"
            }
        },
        {
            "name": "test_bq27427",
            "displayName": "Test: BQ27427 fuel gauge",
            "inherits": "test_base",
            "binaryDir": "${sourceDir}/build/tests/bq27427",
            "cacheVariables": {
                "CONFIG_SENSEWEAR_TEST_BQ27427_DRIVER": "y",
                "CONFIG_SHELL": "n",
                "CONFIG_I2C_SHELL": "n"
            }
        },
        {
            "name": "test_bhi360",
            "displayName": "Test: BHI360 IMU",
            "inherits": "test_base",
            "binaryDir": "${sourceDir}/build/tests/bhi360",
            "cacheVariables": {
                "CONFIG_SENSEWEAR_TEST_BHI360_DRIVER": "y",
                "CONFIG_SHELL": "n",
                "CONFIG_I2C_SHELL": "n"
            }
        },
        {
            "name": "test_lp5562",
            "displayName": "Test: LP5562 LED controller",
            "inherits": "test_base",
            "binaryDir": "${sourceDir}/build/tests/lp5562",
            "cacheVariables": {
                "CONFIG_SENSEWEAR_TEST_LP5562_DRIVER": "y",
                "CONFIG_SHELL": "n",
                "CONFIG_I2C_SHELL": "n"
            }
        },
        {
            "name": "test_m95p",
            "displayName": "Test: M95P EEPROM",
            "inherits": "test_base",
            "binaryDir": "${sourceDir}/build/tests/m95p",
            "cacheVariables": {
                "CONFIG_SENSEWEAR_TEST_M95P_DRIVER": "y",
                "CONFIG_SHELL": "n",
                "CONFIG_I2C_SHELL": "n"
            }
        },
        {
            "name": "test_tpsm83102",
            "displayName": "Test: TPSM83102 regulator",
            "inherits": "test_base",
            "binaryDir": "${sourceDir}/build/tests/tpsm83102",
            "cacheVariables": {
                "CONFIG_SENSEWEAR_TEST_TPSM83102_DRIVER": "y",
                "CONFIG_SHELL": "n",
                "CONFIG_I2C_SHELL": "n"
            }
        },
        {
            "name": "test_drv2605",
            "displayName": "Test: DRV2605 haptics (sensewear_haptic shield)",
            "inherits": "test_base",
            "binaryDir": "${sourceDir}/build/tests/drv2605",
            "cacheVariables": {
                "SHIELD": "sensewear_haptic",
                "CONFIG_SENSEWEAR_TEST_DRV2605_DRIVER": "y",
                "CONFIG_SHELL": "n",
                "CONFIG_I2C_SHELL": "n"
            }
        },
        {
            "name": "test_max30101",
            "displayName": "Test: MAX30101 PPG (sensewear_ppg shield)",
            "inherits": "test_base",
            "binaryDir": "${sourceDir}/build/tests/max30101",
            "cacheVariables": {
                "SHIELD": "sensewear_ppg",
                "CONFIG_SENSEWEAR_TEST_MAX30101_DRIVER": "y",
                "CONFIG_SHELL": "n",
                "CONFIG_I2C_SHELL": "n"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "senswear_nrf54l15_cpuapp",
            "configurePreset": "senswear_nrf54l15_cpuapp"
        },
        {
            "name": "test_bq25180",
            "configurePreset": "test_bq25180"
        },
        {
            "name": "test_bq27427",
            "configurePreset": "test_bq27427"
        },
        {
            "name": "test_bhi360",
            "configurePreset": "test_bhi360"
        },
        {
            "name": "test_lp5562",
            "configurePreset": "test_lp5562"
        },
        {
            "name": "test_m95p",
            "configurePreset": "test_m95p"
        },
        {
            "name": "test_tpsm83102",
            "configurePreset": "test_tpsm83102"
        },
        {
            "name": "test_drv2605",
            "configurePreset": "test_drv2605"
        },
        {
            "name": "test_max30101",
            "configurePreset": "test_max30101"
        }
    ]
}