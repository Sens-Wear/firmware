ZEPHYR_OBJDUMP=/path/to/nordic/ncs/toolchains/toolchain-id/opt/zephyr-sdk/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-objdump
ZEPHYR_NM=/path/to/nordic/ncs/toolchains/toolchain-id/opt/zephyr-sdk/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-nm
OPENOCD=/path/to/openocd
