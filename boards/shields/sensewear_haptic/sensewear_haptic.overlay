/ {
	aliases {
		sensewear-daughter = &drv2605;
		sensewear-haptic = &drv2605;
	};
};

&sys_i2c_peripheral {
	drv2605: drv2605@5a {
		compatible = "sensewear,drv2605";
		reg = <0x5a>;
		/* Enable uses SENSOR_GPIO_0 / P1.14 claimed through daughter_if. */
		status = "okay";
		actuator-mode = "LRA";
		loop-gain = "HIGH";
		feedback-brake-factor = "2X";
		label = "drv2605";
		/* Powered from the shared daughter-connector rail (VDD_DAUGHTER). */
		vin-supply = <&tpsm83102>;
	};
};
